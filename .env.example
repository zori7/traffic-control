# Compose overrides for `docker compose up`. Copy to `.env` and edit as needed;
# every value below is optional and falls back to the defaults in
# docker-compose.yml.

# Sign JWT sessions. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# Set to production and COOKIE_SECURE=true once served over HTTPS.
ENVIRONMENT=production
COOKIE_SECURE=false

# Browser origin allowed to talk to the API (the web service port).
CORS_ORIGINS=http://localhost:8080

# Worker concurrency (CPU inference is the bottleneck) and device.
MAX_CONCURRENT_STREAMS=2
YOLO_DEVICE=cpu
