{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.13",
  "typeCheckingMode": "basic",
  "include": ["backend"],
  "exclude": [
    "**/node_modules",
    "**/.venv",
    "**/__pycache__",
    "backend/alembic/versions"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": ["backend"]
    }
  ],
  "reportMissingImports": true,
  "reportMissingTypeStubs": false
}
