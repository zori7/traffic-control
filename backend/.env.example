# Traffic Control — backend configuration
APP_NAME="Traffic Control"
ENVIRONMENT=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://traffic:traffic@localhost:5432/traffic_control
DB_ECHO=false

# Auth cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173
