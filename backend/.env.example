# Traffic Control — backend configuration
APP_NAME="Traffic Control"
ENVIRONMENT=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://traffic:traffic@localhost:5432/traffic_control
DB_ECHO=false

# Auth cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Counting engine
MEDIA_DIR=media
MAX_CONCURRENT_STREAMS=2
YOLO_MODEL=yolo11n.pt
YOLO_IMGSZ=768
YOLO_CONF=0.1
YOLO_DEVICE=cpu
DECODE_MAX_WIDTH=1280
CORRIDOR_FRACTION=0.06
VIDEO_CODEC=libx264
OUTPUT_FPS=12
HLS_SEGMENT_SECONDS=2
HLS_LIST_SIZE=6
COUNT_FLUSH_SECONDS=5
MEDIA_TOKEN_EXPIRE_MINUTES=360
